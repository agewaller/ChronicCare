# =============================================================================
# AI プロバイダー API キー
# =============================================================================
# 使用するプロバイダーのキーのみ設定すればOK（使わないものは空でよい）
#
# プロンプト（prompts/*.yaml）の model: 指定に応じて自動的にルーティングされる:
#   claude-*   → ANTHROPIC_API_KEY
#   gpt-*, o1-*, o3-* → OPENAI_API_KEY
#   gemini-*   → GOOGLE_API_KEY

# Anthropic Claude（デフォルト推奨: claude-opus-4-6）
# 発行: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI GPT（gpt-4o, o1 等を使う場合）
# 発行: https://platform.openai.com/api-keys
# 課金: https://platform.openai.com/settings/organization/billing
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini（gemini-2.5-pro 等を使う場合）
# 発行: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# ログレベル（オプション、デフォルト: INFO）
# =============================================================================
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
